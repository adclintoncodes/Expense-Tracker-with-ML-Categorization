# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- SQLite (persist locally; do not commit DB files) ---
backend/data/*.db
backend/data/*.db-*
*.sqlite
*.sqlite3

# Keep the data directory itself (with a placeholder)
!backend/data/
!backend/data/.gitkeep

# --- ML artifacts ---
# Optional: keep the trained joblib tracked for out-of-box Docker runs.
# Uncomment the next line if you prefer not to commit model binaries:
# backend/ml/models/*.joblib
*.pkl

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Docker / local overrides ---
docker-compose.override.yml
